{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Detect APM dependencies pinned to a commit on a branch and APM marketplace entries in apm.yml files; Renovate's built-in apm manager updates dependencies pinned to tags"
  ],
  "customManagers": [
    {
      "description": "Update APM dependencies pinned to a commit on a branch.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?<indentation>[\\t ]*)-[^\\S\\n]+(?<depName>(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)(?:/(?<apmSubdir>[^\\s#@]+))?)#(?<currentDigest>[0-9a-f]{40})[^\\S\\n]+#[^\\S\\n]+(?<currentValue>[A-UW-Za-uw-z][A-Za-z0-9_./-]*|[vV][A-Za-z_/-][A-Za-z0-9_./-]*)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{packageName}}}.git",
      "depTypeTemplate": "apm"
    },
    {
      "description": "Update marketplace APM entries pinned to release tags.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?:-[^\\S\\n]+name:[^\\S\\n]+[^\\n]+\\n[^\\S\\n]+source:[^\\S\\n]+(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n[^\\S\\n]+subdir:[^\\S\\n]+(?<apmSubdir>[^\\n]+)\\n[^\\S\\n]+ref:[^\\S\\n]+)(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>v?\\d+\\.\\d+\\.\\d+[A-Za-z0-9_.+-]*)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "depNameTemplate": "{{{packageName}}}/{{{apmSubdir}}}",
      "packageNameTemplate": "{{{packageName}}}",
      "depTypeTemplate": "apm"
    },
    {
      "description": "Update marketplace APM entries pinned to branches.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?:-[^\\S\\n]+name:[^\\S\\n]+[^\\n]+\\n[^\\S\\n]+source:[^\\S\\n]+(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n[^\\S\\n]+subdir:[^\\S\\n]+(?<apmSubdir>[^\\n]+)\\n[^\\S\\n]+ref:[^\\S\\n]+)(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>[A-UW-Za-uw-z][A-Za-z0-9_./-]*|[vV][A-Za-z_/-][A-Za-z0-9_./-]*)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{packageName}}}.git",
      "depNameTemplate": "{{{packageName}}}/{{{apmSubdir}}}",
      "depTypeTemplate": "apm"
    }
  ],
  "packageRules": [
    {
      "description": [
        "The built-in apm manager looks a branch name up as a tag and reports 'Could not determine new digest'; the branch dependency manager above updates those pins instead"
      ],
      "matchManagers": ["apm"],
      "matchCurrentValue": "!/^[vV]?[0-9]/",
      "enabled": false
    },
    {
      "description": ["Group APM package updates together and keep them under manual review"],
      "groupName": "apm packages",
      "matchDepTypes": ["apm", "apm-dev"],
      "labels": ["dependencies", "apm"],
      "automerge": false
    },
    {
      "description": [
        "Branch-tracked APM refs use git-refs, which has no release timestamp; skip the release-age delay and rely on manual review"
      ],
      "matchDepTypes": ["apm"],
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": "0"
    }
  ]
}
