{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Update APM marketplace entries in apm.yml files and keep APM updates grouped under manual review; Renovate's built-in apm manager updates APM dependencies"
  ],
  "customManagers": [
    {
      "description": "Update marketplace APM entries pinned to release tags.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?:-[^\\S\\n]+name:[^\\S\\n]+[^\\n]+\\n[^\\S\\n]+source:[^\\S\\n]+(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n[^\\S\\n]+subdir:[^\\S\\n]+(?<apmSubdir>[^\\n]+)\\n[^\\S\\n]+ref:[^\\S\\n]+)(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>v?\\d+\\.\\d+\\.\\d+[A-Za-z0-9_.+-]*)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "depNameTemplate": "{{{packageName}}}/{{{apmSubdir}}}",
      "packageNameTemplate": "{{{packageName}}}",
      "depTypeTemplate": "apm"
    },
    {
      "description": "Update marketplace APM entries pinned to branches.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?:-[^\\S\\n]+name:[^\\S\\n]+[^\\n]+\\n[^\\S\\n]+source:[^\\S\\n]+(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n[^\\S\\n]+subdir:[^\\S\\n]+(?<apmSubdir>[^\\n]+)\\n[^\\S\\n]+ref:[^\\S\\n]+)(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>[A-UW-Za-uw-z][A-Za-z0-9_./-]*|[vV][A-Za-z_/-][A-Za-z0-9_./-]*)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{packageName}}}.git",
      "depNameTemplate": "{{{packageName}}}/{{{apmSubdir}}}",
      "depTypeTemplate": "apm"
    }
  ],
  "packageRules": [
    {
      "description": [
        "Group APM package updates together and keep them under manual review; the built-in apm manager gives devDependencies the apm-dev type"
      ],
      "groupName": "apm packages",
      "matchDepTypes": ["apm", "apm-dev"],
      "labels": ["dependencies", "apm"],
      "automerge": false
    },
    {
      "description": [
        "Branch-tracked APM refs use git-refs, which has no release timestamp; skip the release-age delay and rely on manual review"
      ],
      "matchDepTypes": ["apm"],
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": "0"
    }
  ]
}
