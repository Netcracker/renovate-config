{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": ["Detect APM package dependencies in apm.yml files"],
  "customManagers": [
    {
      "description": "Update APM dependencies pinned to version tags with #.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?<indentation>[\\t ]*)-\\s+(?<depName>(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(?<apmSubdir>[^\\s#@]+))#(?:[0-9a-f]{40}\\s+#\\s+)?(?<currentValue>[A-Za-z_./-][A-Za-z0-9_./-]*)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "depTypeTemplate": "apm",
      "autoReplaceStringTemplate": "{{{indentation}}}- {{{depName}}}#{{{newValue}}}"
    },
    {
      "description": "Update marketplace APM entries pinned to release tags.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?:-[^\\S\\n]+name:[^\\S\\n]+[^\\n]+\\n[^\\S\\n]+source:[^\\S\\n]+(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n[^\\S\\n]+subdir:[^\\S\\n]+(?<apmSubdir>[^\\n]+)\\n[^\\S\\n]+ref:[^\\S\\n]+)(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>v?\\d+\\.\\d+\\.\\d+[A-Za-z0-9_.+-]*)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver",
      "depNameTemplate": "{{{packageName}}}/{{{apmSubdir}}}",
      "packageNameTemplate": "{{{packageName}}}",
      "depTypeTemplate": "apm"
    },
    {
      "description": "Update marketplace APM entries pinned to branches.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)apm\\.yml$/"],
      "matchStrings": [
        "(?:-[^\\S\\n]+name:[^\\S\\n]+[^\\n]+\\n[^\\S\\n]+source:[^\\S\\n]+(?<packageName>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\n[^\\S\\n]+subdir:[^\\S\\n]+(?<apmSubdir>[^\\n]+)\\n[^\\S\\n]+ref:[^\\S\\n]+)(?<currentDigest>[0-9a-f]{40})\\s+#\\s+(?<currentValue>[A-UW-Za-uw-z][A-Za-z0-9_./-]*|[vV][A-Za-z_/-][A-Za-z0-9_./-]*)"
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{packageName}}}.git",
      "depNameTemplate": "{{{packageName}}}/{{{apmSubdir}}}",
      "depTypeTemplate": "apm"
    }
  ],
  "packageRules": [
    {
      "description": ["Group APM package updates together and keep them under manual review"],
      "groupName": "apm packages",
      "matchDepTypes": ["apm", "apm-dev"],
      "labels": ["dependencies", "apm"],
      "automerge": false
    },
    {
      "description": [
        "Look up an APM dependency pinned to a commit on a branch, such as package#<sha>  # main, through git-refs. Renovate's built-in apm manager reads the comment after the commit as a release tag, and github-tags has no tag by a branch name. A comment that is a release tag (v1.2.3, 1.2.3, or <name>-v1.2.3, with an optional prerelease or build suffix) stays a tag lookup. git versioning keeps a digit in a branch name, as in release/1.2.0 or lts/26.1, from being read as a version"
      ],
      "matchManagers": ["apm"],
      "matchDatasources": ["github-tags"],
      "matchCurrentValue": "!/^(?:[^/]+[-_])?v?\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.+-]*)?$/",
      "overrideDatasource": "git-refs",
      "overridePackageName": "https://github.com/{{{packageName}}}.git",
      "versioning": "git"
    },
    {
      "description": [
        "Branch-tracked APM refs use git-refs, which has no release timestamp; skip the release-age delay and rely on manual review"
      ],
      "matchDepTypes": ["apm", "apm-dev"],
      "matchDatasources": ["git-refs"],
      "minimumReleaseAge": "0"
    }
  ]
}
